	(
		SELECT ---------- This is from the total of the union 
			Acct_No, 
			MIN(NextPmtDate) AS NextPaymentDate
				FROM 
						(
						SELECT -----These are what's being unioned 
								Acct_No, 
								CCorPBP, 
								NextPmtDate, 
								SumPmtAmt 
						FROM 
								(
										SELECT          
												CCT.Acct_ID as acct_no,
												'PBP' as CCORPBP,
												--CCT.INS_DATE, 
												MIN(CCT.SCHED_DATE) as NextPmtDate, 
												--CCT.INS_USER, 
												--CCS.DESCRIPTION, 
												--MRP.STATUS, 
												--MRP.DETAIL, 
												--MRP.COLLECTION_STATUS, 
												--MRP.COLLECTION_MT_STATUS, 
												--SUM(CCT.SURCHARGE) as SumSurcharge, 
												SUM(CCT.AMOUNT) as SumPmtAmt

									FROM        CREDIT.ECC_TRANSACTION  CCT, 
												CREDIT.ECC_TRANS_STATUS CCS, 
												MORT.MRMASTERP          MRP

									WHERE           ( ( CCS.TRANS_STATUS = CCT.TRANS_STATUS ) 
													AND   ( MRP.ACCT_NO      = CCT.ACCT_ID ) 
													AND   ( CCS.DESCRIPTION  = 'Pending' ) 
													AND   ( CCT.SCHED_DATE >= To_Date(To_Char(Current_Date,'mmddyyyy'),'mmddyyyy') ) )

									GROUP BY    CCT.Acct_ID,
                                                'PBP'

										)qtEccTransaction
				UNION ALL 

						SELECT 
								Acct_No, 
								CCorPBP, 
								NextPmtDate, 
								SumPmtAmt 
						FROM 
										(
										SELECT   
												CFP.ACCT_NO, 
												'CC' as CCorPBP,
												MIN(CFP.PAYMENT_DATE) as NextPmtDate, 
												--CFP.RECUR_STATUS, 
												--CFP.INS_DATE, 
												--CFP.INS_USER,
												SUM(CFP.PMT_AMT) as SumPmtAmt,
												count(*)

										FROM        
												CREDIT.CC_FUTURE_PAYMENTS CFP

										WHERE  
                                                ( CFP.RECUR_STATUS NOT IN ('4','5','6') ) 
												--( ( CFP.RECUR_STATUS NOT IN ('4','5','6','9') )
												--AND   ( CFP.PAYMENT_DATE >= To_Date(To_Char(Current_Date,'mmddyyyy'),'mmddyyyy') ) )

										GROUP BY    CFP.ACCT_NO, 
                                                     'CC'
						)qtCcFuturePayments
			)
    GROUP BY acct_no
										
	)qxNextFuturePayment,

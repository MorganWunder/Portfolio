        tqxDefaultReport_1.LAST_COMM55_DATE AS COMM55_DATE,
		tqxDefaultReport_1.COMMENT55_USER_ID AS COMMENT55_USERID, 
        tqxDefaultReport_1.LAST_COMMENT55 AS COMMENT55, 
		tqxDefaultReport_1.LAST_COMM01_DATE AS COMM01_DATE, 
		tqxDefaultReport_1.LAST_COMMENT01 AS COMMENT01, 

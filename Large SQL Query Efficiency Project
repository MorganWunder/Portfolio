                (select
                ACCT_NO,
                MAX(PYMT_AMT) KEEP (DENSE_RANK LAST ORDER BY PYMT_DATE ASC) AS LAST_MT_PAYMENT,
                MAX(regexp_replace(DOC_TYPE, '[^[:alpha:]]','')) KEEP (DENSE_RANK LAST ORDER BY PYMT_DATE ASC) AS LAST_MT_PAYMENT_DOC_TYPE,
                MAX(PYMT_DATE) KEEP (DENSE_RANK LAST ORDER BY PYMT_DATE ASC) AS LAST_MT_PAYMENT_DATE
                from MTPAYHIST
                where regexp_replace(DOC_TYPE, '[^[:alpha:]]','') in ('UT', 'U', 'M', 'T', 'MI', 'ML')
                Group by ACCT_NO) MTPAYHIST,
 -----------------------------------------------------               
				( 
				SELECT         
						ACCT_NO,         
						MAX(COMM_DATE) KEEP(DENSE_RANK LAST ORDER BY COMM_DATE ASC) AS LAST_COMM01_DATE,         
						MAX(COMMENT1) KEEP (DENSE_RANK LAST ORDER BY COMM_DATE ASC) AS  LAST_COMMENT01,         
						MAX(USER_ID) KEEP (DENSE_RANK LAST ORDER BY COMM_DATE ASC) AS COMMENT01_USER_ID 
				FROM         
						ALCOMM 
				WHERE         
						REASON_CODE IN ('01')  AND 
						(
						((INSTR(UPPER(COMMENT1),'LTR')>=1) 		and        
						(( INSTR(UPPER(COMMENT1),'1ST')>=1) 	OR  
						(INSTR(UPPER(COMMENT1),'2ND')>=1) 		OR 
						(INSTR(UPPER(COMMENT1),'3RD')>=1) 		OR 
						(INSTR(UPPER(COMMENT1),'4TH')>=1)))   	OR    
						((INSTR(UPPER(COMMENT1),'CONTACT')>=1) 	and        
						(( INSTR(UPPER(COMMENT1),'1ST')>=1) 	OR  
						(INSTR(UPPER(COMMENT1),'2ND')>=1) 		OR 
						(INSTR(UPPER(COMMENT1),'3RD')>=1) 		OR 
						(INSTR(UPPER(COMMENT1),'4TH')>=1)))) 
				Group BY             
						ACCT_NO 
				) D,
-------------------------------------------------------
				(
				SELECT     
						ACCT_NO,     
						MIN(PAYMENT_DATE)KEEP (DENSE_RANK LAST ORDER BY  Payment_Date DESC) AS Payment_Date,      
						MIN(PMT_AMT) KEEP (DENSE_RANK LAST ORDER BY  Payment_Date DESC) AS Payment_Amount  
				FROM      
						CREDIT.CC_FUTURE_PAYMENTS tFuture 
				WHERE       
						tFuture.PAYMENT_DATE>=trunc(sysdate) and     

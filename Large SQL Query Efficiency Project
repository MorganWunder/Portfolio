						CASE WHEN REASON_CODE='55' THEN MAX(COMM_DATE) KEEP (DENSE_RANK LAST ORDER BY COMM_DATE ASC) END AS LAST_COMM55_DATE, 
						CASE WHEN REASON_CODE='55' THEN MAX(COMMENT1) KEEP (DENSE_RANK LAST ORDER BY COMM_DATE ASC) END AS  LAST_COMMENT55, 
						CASE WHEN REASON_CODE='55' THEN MAX(USER_ID)  KEEP (DENSE_RANK LAST ORDER BY COMM_DATE ASC) END AS COMMENT55_USER_ID,
						--85
						CASE WHEN REASON_CODE='85' THEN MAX(COMM_DATE) KEEP (DENSE_RANK LAST ORDER BY COMM_DATE ASC) END AS LAST_COMM85_DATE, 
						CASE WHEN REASON_CODE='85' THEN MAX(COMMENT1) KEEP (DENSE_RANK LAST ORDER BY COMM_DATE ASC) END AS  LAST_COMMENT85, 
						CASE WHEN REASON_CODE='85' THEN MAX(USER_ID)  KEEP (DENSE_RANK LAST ORDER BY COMM_DATE ASC) END AS COMMENT85_USER_ID
						
				FROM               
						ALCOMM          
                    WHERE reason_code IN ('46','55','85')
                    AND comm_date>=sysdate-730
				Group BY  ACCT_NO, REASON_CODE    
				) B,

        tqxDefaultReport_1.CONTRACT_TYPE as "Trade_Contract_type",
        tqxDefaultReport_1.TSTATUS as "Trade_Status",
        tqxDefaultReport_1.TDETAIL as "Trade_Detail",        
		tqxDefaultReport_1.QCD_Obtained AS "Have QCD?",
		tqxDefaultReport_1.QCD_Recorded_Date AS "QCD Recorded Dt",
		CASE WHEN tqxDefaultReport_1.Cntr Is Null THEN Null ELSE '*****' END  AS "Mult From",
		tqxDefaultReport_1.SCHEDULE_PAYMENT_DATE,
		tqxDefaultReport_1.SCHEDULE_PAYMENT_AMOUNT, 
		tqxDefaultReport_1.PAYMENT_STATUS, 
		tqxDefaultReport_1.NEXT_PAYMENT_DATE, 
		tqxDefaultReport_1.Possible_Tab_4,

		CASE WHEN (
		SELECT
				MAX(INV.acct_no) AS ACCT_NO
		FROM
				MCP 
				LEFT JOIN MORT.MRWEEKP WP ON MCP.ACCT_NO=WP.ACCT_NO
				LEFT JOIN 
							MASTER.TIINVEN INV ON 
                            MCP.LOC_CODE=INV.LOC_CODE AND
							WP.BLDG=INV.BLDG AND
							WP.UNIT=INV.UNIT AND
							NVL(WP.SUB_UNIT,'-')=NVL(INV.SUB_UNIT,'-') AND

        RefInv.Time_Flag,
        RefInv.OwnershipVal, */
        MatchInv.ACCT_NO as Matched_account,
        MatchInv.SD as Matched_SD,
        --MatchInv.loc_code as Matched_Loc_code,
        --MatchInv.BLDG as Matched_BLDG,
        --MatchInv.UNIT as Matched_UNIT,
        --MatchInv.SUB_UNIT as Matched_SUB_UNIT,
        --MatchInv.week as Matched_week,
        --MatchInv.OwnershipVal as matched_OwnershipVal,
        --MatchInv.Time_Flag as Matched_Time_Flag,
        MatchInv.DEED_STATUS as Matched_DEED_STATUS,
        MatchInv.CONTR_DATE as Matched_CONTR_DATE
        
  from
  (
  select  
          wk.acct_no,
          mrp.status || mrp.detail as sd,
          mcp.loc_code, 
          wk.BLDG, 
          wk.UNIT,
          nvl(wk.SUB_UNIT,'99999') as SUB_UNIT, 
          wk.week,
           sum( (case 
               when wk.ownership_time='E' then 1
               when wk.ownership_time='O' then 2
               when wk.ownership_time='W' then 3
               else 4 end)
              ) as OwnershipVal,
          case 
          when (sum( (case 
               when wk.ownership_time='E' then 1
               when wk.ownership_time='O' then 2
               when wk.ownership_time='W' then 3
               else 4 end)
              ))=1 then 'Even'
          when (sum( (case 
               when wk.ownership_time='E' then 1
               when wk.ownership_time='O' then 2
               when wk.ownership_time='W' then 3
               else 4 end)
              ))=2 then 'Odd'
           when (sum( (case 
               when wk.ownership_time='E' then 1
               when wk.ownership_time='O' then 2
               when wk.ownership_time='W' then 3
               else 4 end)
              ))=3 then 'Whole'
              else 'Undetermined' end as Time_Flag
  from 
          mort.mrweekp wk, 
          mcp,
          mrp
          
  where 
          wk.acct_no=mcp.acct_no and 
          mcp.acct_no=mrp.acct_no 
          --wk.acct_no=33783377642
          --wk.acct_no=73484454449
          --and
          --mp.status not in ('X','T') and
          --mp.status || mp.detail not in ('CT','CQ')
          
  group by 
          
          mcp.loc_code, 
          wk.BLDG, 
          wk.UNIT,
          nvl(wk.SUB_UNIT,'99999'), 
          wk.week,
          wk.acct_no,
          mrp.status || mrp.detail
          
  )RefInv,
  (
  select  
          wk.acct_no,
          mrp.status || mrp.detail as sd,
          mcp.loc_code, 
          wk.BLDG, 
          wk.UNIT,
          nvl(wk.SUB_UNIT,'99999') as SUB_UNIT, 
          wk.week,
          mcp.CONTR_DATE,
          mrp.DEED_STATUS,
           sum( (case 
               when wk.ownership_time='E' then 1
               when wk.ownership_time='O' then 2
               when wk.ownership_time='W' then 3
               else 4 end)
              ) as OwnershipVal,
          case 
          when (sum( (case 
               when wk.ownership_time='E' then 1
               when wk.ownership_time='O' then 2
               when wk.ownership_time='W' then 3
               else 4 end)
              ))=1 then 'Even'
          when (sum( (case 
               when wk.ownership_time='E' then 1
               when wk.ownership_time='O' then 2
               when wk.ownership_time='W' then 3
               else 4 end)
              ))=2 then 'Odd'
            when (sum( (case 
               when wk.ownership_time='E' then 1
               when wk.ownership_time='O' then 2
               when wk.ownership_time='W' then 3
               else 4 end)
              ))=3 then 'Whole'
              else 'Undetermined' end as Time_Flag
  from 
          mort.mrweekp wk, 
          mcp,
          mrp
          
  where 
          wk.acct_no=mcp.acct_no and 
          mcp.acct_no=mrp.acct_no and
          mrp.status not in ('X','T') and
          mrp.status || mrp.detail not in ('XQ','CLM','CQM','CT','CTU','CFM','CQ')
          
 group by 
          
          mcp.loc_code, 
          wk.BLDG, 
          wk.UNIT,
          nvl(wk.SUB_UNIT,'99999'), 
          wk.week,
          wk.acct_no,
          mrp.status || mrp.detail,
          mcp.CONTR_DATE,
          mrp.DEED_STATUS
          
  )MatchInv
  
  where
      --RefInv.acct_no<>MatchInv.acct_no(+) and
      RefInv.loc_code=MatchInv.loc_code(+)    and
      RefInv.BLDG=MatchInv.BLDG(+)            and
      RefInv.UNIT=MatchInv.UNIT(+)            and
      RefInv.SUB_UNIT=MatchInv.SUB_UNIT(+)    and
      RefInv.week=MatchInv.week (+)              and
      (RefInv.OwnershipVal=MatchInv.OwnershipVal or MatchInv.OwnershipVal=3 or MatchInv.OwnershipVal is null or (RefInv.OwnershipVal=3 and MatchInv.OwnershipVal is not null))
) OTHER_ACCOUNTS on OTHER_ACCOUNTS.ACCT_NO = tqxDefaultReport_1.acctno



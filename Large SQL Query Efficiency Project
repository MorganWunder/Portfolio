		tqxDefaultReport_1.LAST_COMM46_DATE AS COMM46_DATE,
		tqxDefaultReport_1.COMMENT46_USER_ID AS COMMENT46_USERID, 
		tqxDefaultReport_1.LAST_COMM85_DATE AS COMM85_DATE, 

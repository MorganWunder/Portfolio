		WHERE

				tqxDefaultReport_1.Trade_From_Acct=MCP.ACCT_NO and
				nvl(INV.acct_no,0)<>MCP.ACCT_NO		  and
				nvl(INV.acct_no,0)<>tqxDefaultReport_1.Trade_From_Acct and
				(WP.Ownership_Time = 'W'  OR
                ((WP.Ownership_Time = 'E') and (INV.Time_Flg in ('E','W'))) or
                ((WP.Ownership_Time = 'O') and (INV.Time_Flg in ('O','W'))))


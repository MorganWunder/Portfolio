-- Temp Table for Total Revenue
IF OBJECT_ID('tempdb..#FB_Total_Rev') IS NOT NULL 
DROP TABLE #FB_Total_Rev;


SELECT ld.company_code,
    ld.department_code,
    ld.location_code, 
    ld.Accounting_period,
    ld.Accounting_Year,
    ld.Accounting_Month,
    SUM(ld.Current_Amount)*-1 as Total_Rev --Leave as a positive for the RevPOR calc later    

INTO #FB_Total_Rev
FROM #data ld 

    Right join #FB_REV_COGs fb ON ld.account_code=fb.Revenue_acct

WHERE ld.Company_Code IS NOT NULL 

GROUP BY ld.company_code,
    ld.department_code,
    ld.location_code,
    ld. Accounting_period,
    ld.Accounting_Year,
    ld.Accounting_Month
;

--Temp table for Percent of Total Revenue
IF OBJECT_ID('tempdb..#FB_PercRev') IS NOT NULL 
DROP TABLE #FB_PercRev;

SELECT ld.company_code,
        ld.department_code,
        ld.location_code,
        ld.account_code, 
        fb.join_order,
        fb.Rev_perc_of_rev,
        ld. Accounting_period,
        ld.Accounting_Year,
        ld.Accounting_Month,
        (ld.Current_amount)*-1 as Rev_amt, 
        tr.Total_Rev,
        (ld.current_amount*-1)/ iif(Total_Rev=0,1.000000,Total_rev) as perc_of_rev_amt  --This needs to be positive because Total Rev is positive 

            INTO #FB_PercRev
            FROM  #data ld

            RIGHT JOIN #FB_REV_COGs fb ON ld.account_code=fb.Revenue_acct

             LEFT JOIN #fb_total_rev tr

            ON tr.Company_Code= ld.company_code AND tr.Department_code=ld.department_code AND tr.Accounting_Period=ld.accounting_period

            WHERE ld.Company_Code IS NOT NULL
;
-- Temp table for COGS Percent of Associated Rev 
IF OBJECT_ID('tempdb..#FB_COGs_Perc') IS NOT NULL 
DROP TABLE #FB_COGs_Perc;


SELECT ld.Company_Code,
    ld.Department_Code,
    ld.location_code, 
    ld.Accounting_Period,
    ld.Accounting_Year,
    ld.Accounting_Month, 
    ld.Account_Code,
    fb. COGS_desc,
    fb.join_order, 
    ld.Current_Amount as COGs_amt,
    pr.Rev_amt,
    fb.COGS_perc_of_rev,
    ld.Current_Amount/iif(pr.Rev_amt=0,1.000000,pr.Rev_amt) as COGS_Perc

INTO #FB_COGs_Perc
FROM #data ld

RIGHT JOIN #FB_REV_COGs fb ON ld.account_code=fb.COGS_acct

LEFT JOIN #FB_PercRev pr

 ON (ld.Company_Code=pr.company_code AND ld.Department_Code=pr.department_code AND ld.accounting_Period=pr.accounting_period and fb.join_order=pr.join_order)

 WHERE ld.Company_Code IS NOT NULL ;




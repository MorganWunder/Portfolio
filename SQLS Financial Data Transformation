IF OBJECT_ID('tempdb..#rates') IS NOT NULL 
DROP TABLE #rates;

select * into #rates from (

select  ld.accounting_period
        , map.Merge_Company_Code  --Use an if to look for all the company codes if merge company is null 
        , map.Merge_Location_Code -- "" 
        , ld.Department_Code
        , convert(numeric(30,10) ,sum(iif(iif(@Scenario = 'Budget',bud_ben.Pay_Bene_Leaf,ben.Pay_Bene_Leaf) = 'Payroll-Total', Current_Amount, 0.000000))) as Payroll_Total_Amount
        , convert(numeric(30,10) ,sum(iif(ben.Pay_Bene_Leaf = 'Fringe Benefits - Forecast Rate', Current_Amount, 0.000000))) as Fringe_Amount
        , convert(numeric(30,10) ,sum(iif(ben.Pay_Bene_Leaf = '401k Employer - Forecast Rate', Current_Amount, 0.000000))) as Ret_Amount
        , convert(numeric(30,10) ,sum(iif(ben.Pay_Bene_Leaf = 'Workers Comp - Forecast Rate', Current_Amount, 0.000000))) as Work_Comp_Amount
        , convert(numeric(30,10) ,sum(iif(ben.Pay_Bene_Leaf = 'FICA/Medicare - Forecast Rate', Current_Amount, 0.000000))) as FICA_Amount
        , convert(numeric(30,10) ,sum(iif(ben.Pay_Bene_Leaf = 'Federal Unemployment - Forecast Rate', Current_Amount, 0.000000))) as Fed_Unemp_Amount
        , convert(numeric(30,10) ,sum(iif(ben.Pay_Bene_Leaf = 'State Unemployment - Forecast Rate', Current_Amount, 0.000000))) as State_Unemp_Amount
from    #data ld

        left join Finance.FS_Ref.T000_R_Code_Ref_Descr map
            on ld.Consol_HOA_Company_Code = map.R_Code
            and map.Active_Flag = 1

        left join dev_fpa.fs_ref.benefits_mapping ben
            on ld.Account_Code = ben.Account_Code

        left join #Budget_Benefits_Map bud_ben
            on ld.Account_Code = bud_ben.Account_Code

where   ld.account_code in (4221002,4224001,4226001,4227001,4228001,4229001,4211001,4213001,4220001,4220003,4214601)
        and Consol_HOA_Company_Code_and_Descr is not null and map.Merge_Company_Code is not null

group by ld.accounting_period
        , map.Merge_Company_Code
        , map.Merge_Location_Code
        , ld.Department_Code


UNION 

select ld.accounting_period
        , ld.Company_Code as Merge_company_code
        , ld.Location_Code as merge_location_code
        , ld.Department_Code
        , convert(numeric(30,10) ,sum(iif(iif(@Scenario = 'Budget',bud_ben.Pay_Bene_Leaf,ben.Pay_Bene_Leaf) = 'Payroll-Total', Current_Amount, 0.000000))) as Payroll_Total_Amount
        , convert(numeric(30,10) ,sum(iif(ben.Pay_Bene_Leaf = 'Fringe Benefits - Forecast Rate', Current_Amount, 0.000000))) as Fringe_Amount
        , convert(numeric(30,10) ,sum(iif(ben.Pay_Bene_Leaf = '401k Employer - Forecast Rate', Current_Amount, 0.000000))) as Ret_Amount
        , convert(numeric(30,10) ,sum(iif(ben.Pay_Bene_Leaf = 'Workers Comp - Forecast Rate', Current_Amount, 0.000000))) as Work_Comp_Amount
        , convert(numeric(30,10) ,sum(iif(ben.Pay_Bene_Leaf = 'FICA/Medicare - Forecast Rate', Current_Amount, 0.000000))) as FICA_Amount
        , convert(numeric(30,10) ,sum(iif(ben.Pay_Bene_Leaf = 'Federal Unemployment - Forecast Rate', Current_Amount, 0.000000))) as Fed_Unemp_Amount
        , convert(numeric(30,10) ,sum(iif(ben.Pay_Bene_Leaf = 'State Unemployment - Forecast Rate', Current_Amount, 0.000000))) as State_Unemp_Amount
from    #data ld

        left join dev_fpa.fs_ref.benefits_mapping ben  --For Actuals 
            on ld.Account_Code = ben.Account_Code

        left join #Budget_Benefits_Map bud_ben    -- For Budget 
            on ld.Account_Code = bud_ben.Account_Code

-- Had to change this side to look for nvarchar values instad of INT. 
where  ld.account_code in (N'4221002', N'4224001', N'4226001', N'4227001',N'4228001', N'4229001', N'4211001', N'4213001',N'4220001', N'4220003', N'4214601') 
        and Consol_HOA_Company_Code_and_Descr is null 

group by ld.accounting_period
        , ld.company_code
        , ld.location_code
        , ld.Department_Code

) r


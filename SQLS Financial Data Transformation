IF OBJECT_ID('tempdb..#occup') IS NOT NULL 
DROP TABLE #occup;

select  
        map.Merge_Company_Code as Company_Code  ------------------- need to do isnull situation
        , map.Merge_Location_Code as Location_Code
        , pl.Department_Code
        , pl.Account_Code
        , convert(nvarchar(50), pl.Project_Code) as Project_Code
        , pl.Trading_Partner as Intercompany_Code

    'ICDefault' as Intercompany, --Intercompany
    YEAR(tr.Accounting_Period) AS FiscalYear,
    FORMAT(MONTH(tr.Accounting_Period), '00') AS FiscalMonth,
    convert(numeric(30,6), tr.Total_Rev/a.occ_amt)*-1 Amount --Amount

FROM #FB_Total_Rev tr
LEFT JOIN 
        (SELECT Location_Code,
            Accounting_Month,
            Accounting_Year,
            SUM(amount) as occ_amt

            FROM #occup 

            GROUP BY 
            Location_Code,
            Accounting_Month,
            Accounting_Year
            ) a ON (tr.Location_Code=a.Location_Code AND tr.Accounting_Year=a.Accounting_Year AND tr.Accounting_Month=a.Accounting_Month)
UNION

--Percent of Total Revenue
SELECT 
  pr.Rev_perc_of_rev as Account, -- Account
  pr.company_code as Company, -- Company
  pr.location_code as Location, --Location
  pr.department_code as Department, --Dept
  '000' as Project, --Project
  'ICDefault' as Intercompany, --Intercompany
  pr.accounting_year as Fiscalyear,--Fiscal year
  format(pr.Accounting_Month,'00') as FiscalMonth,--Fiscal month
  convert(numeric(30,6), pr.perc_of_rev_amt) as Amount --Amount


 FROM #FB_PercRev pr


 UNION 

 --Percent of COGs by Associated Rev 
 SELECT 
  cp.cogs_perc_of_rev as Account, -- Account
  cp.company_code as Company, -- Company
  cp.location_code as Location, --Location
  cp.department_code as Department, --Dept
  '000' as Project, --Project
  'ICDefault' as Intercompany, --Intercompany
  cp.accounting_year as Fiscalyear,--Fiscal year
  format(cp.Accounting_Month,'00') as FiscalMonth,--Fiscal month
  convert(numeric(30,6),cp.COGs_Perc) as Amount--Amount


  FROM #FB_COGs_Perc cp



) Result

where Amount <> 0

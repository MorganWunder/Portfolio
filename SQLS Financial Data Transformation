            on pl.Consol_HOA_Company_Code = map.R_Code
            and map.Active_Flag = 1

where pl.department_code = '5141'
        and acct.L8_Account_Descr = '930001P-Total Occupied Room Nights'
        and map.Merge_Company_Code is not null
group by map.Merge_Company_Code 
        , map.Merge_Location_Code 
        , pl.Department_Code
        , pl.Account_Code
        , convert(nvarchar(50), pl.Project_Code)
        , pl.Trading_Partner
        , pl.Accounting_Year
        , pl.Accounting_Month
        , pl.Scenario
        , pl.Scenario_Version


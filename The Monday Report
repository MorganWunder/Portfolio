WITH 
/*
YTD AS (
-- Subqury to get the cal_ytd calculation 
  SELECT dt, ref_date, 
    CASE WHEN dt > ref_date THEN 0 ELSE 1 END AS CAL_YTD
  FROM (
    SELECT DT, DT_YEAR,
        CASE WHEN EXTRACT(YEAR FROM DT) = EXTRACT(YEAR FROM sysdate) THEN MAX(dt) OVER()
        WHEN EXTRACT(YEAR FROM DT) >= EXTRACT(YEAR FROM sysdate) - 1 THEN MAX(DT) OVER() - INTERVAL '365' DAY(3)
        ELSE MAX(DT) OVER() - INTERVAL '731' DAY(4)
        END AS ref_date
    FROM FPA_WEEKLY_NETSALES 
    GROUP BY DT, DT_year
  ) b
  WHERE DT_year >= EXTRACT(YEAR FROM sysdate) - 1
  
  ORDER BY dt desc
),*/
                                                                            -- See if the new date ranges work 
date_ranges as(

--WTD Date Range
SELECT 
'WTD' as timeperiod,
CAST(DT_Year as VARCHAR(10)) as Year, --This has to stay dt year because a week can move across years 
MIN(DT) as mind,
MAX(DT) as maxd
 
FROM FPA_WEEKLY_SALES
 
WHERE DT_WEEK_ISO=CASE  -- If it's the first week of the year look at the max week of the previous year (should be the prior week) 
        WHEN TO_CHAR(SYSDATE, 'IW') = '01' THEN (
        SELECT MAX(DT_WEEK_ISO)
        FROM FPA_WEEKLY_SALES
        WHERE DT_YEAR = EXTRACT(YEAR FROM SYSDATE) - 1
    )
    ELSE TO_CHAR(SYSDATE, 'IW') - 1
END -- This is going to be an issue at the year change 
AND EXTRACT(YEAR FROM DT) >= EXTRACT(YEAR FROM sysdate) - 2
and DT_YEAR >= EXTRACT(YEAR FROM sysdate) - 1
 
GROUP BY DT_year

UNION 

--MTD Date range
SELECT DISTINCT 
'MTD' as timeperiod,
CAST(cal_year as varchar(10)) as year,
MIN(s.dt)as mind,
MAX(s.dt) as maxd

FROM fpa_weekly_sales s
--LEFT JOIN ytd on ytd.dt= s.dt

WHERE EXTRACT(MONTH from s.dt)= EXTRACT(Month FROM sysdate-9) --If it's currently the first week of a new month, look at the previous month and not the current. 
AND cal_year >= EXTRACT(YEAR FROM sysdate) - 1
AND CAL_YTD=1

group by cal_year

UNION
--YTD date ranges
SELECT 
'YTD' as timeperiod,
CAST(cal_year as VARCHAR(10)) as year, 
MIN(s.dt)as mind,
MAX(s.dt) as maxd

FROM fpa_weekly_sales s
--LEFT JOIN ytd on ytd.dt=s.dt

WHERE CAL_YTD=1
AND (
    (TO_CHAR(SYSDATE, 'IW') = '01' AND EXTRACT(YEAR FROM DT) >= EXTRACT(YEAR FROM SYSDATE) - 2) -- If it's the first week of the year, bring in the previous 2 years 
    OR
    (TO_CHAR(SYSDATE, 'IW') > '01' AND EXTRACT(YEAR FROM DT) >= EXTRACT(YEAR FROM SYSDATE) - 1) -- Anything beyond the first week of the year bring in current and previous year 
    ) 
GROUP BY cal_year

UNION 
--Trailing 12 months

SELECT 
'T12' as timeperiod,
MAX(DT_year)-1||'_'||MAX(DT_YEAR) as year,
MIN(dt) as mind,
MAX(dt) as maxd

FROM FPA_WEEKLY_SALES

WHERE DT>= ADD_MONTHS(trunc(sysdate,'MM'),-12) AND DT< trunc(sysdate,'MM')

UNION 
--Previous trailing 12

SELECT 'T12' as timeperiod,
MAX(DT_year)-1||'_'||MAX(DT_YEAR) as year,
MIN(dt) as mind,
MAX(dt) as maxd

FROM FPA_WEEKLY_SALES

WHERE DT>= ADD_MONTHS(trunc(sysdate,'MM'),-24) AND DT< ADD_MONTHS(trunc(sysdate,'MM'),-12)
),


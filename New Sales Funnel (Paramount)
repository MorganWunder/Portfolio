
--Query 1 in Alteryx that creates the Paramount_tosales table in Oracle SQL. 


WITH base AS (
    SELECT DISTINCT ic.invite_seq_id, i.invite_number, se.sales_effort_seq_id, i.country_code
    FROM sam_invite i
    INNER JOIN sam_invite_comment ic
        ON ic.invite_seq_id = i.invITE_SEQ_ID
    INNER JOIN sam_invite_sales_effort se
        ON se.invite_seq_id = i.INVITE_SEQ_ID
    WHERE prospect_source = '5120800'
),

acct_detail AS (
    SELECT
        b.*,
        se.sales_effort_date,
        se.sales_effort_type,
        se.sales_effort_status,
        CASE
            WHEN se.sales_effort_status = 'COMPLETED' THEN 1
            WHEN se.sales_effort_status = 'ON TOUR'  THEN 2
            WHEN se.sales_effort_status = 'SCHEDULED' THEN 3
            WHEN se.sales_effort_status = 'CANCEL' THEN 4
            ELSE 5
        END AS tour_status_rank,
        CASE
            WHEN contract_type='TIMESHARE' THEN 1
            WHEN contract_type='VOA' THEN 2
            ELSE 3 END as contract_rank,
        se.sales_location,
        se.sales_department,
        mr.*
    FROM base b
    LEFT JOIN sam_sales_effort se
        ON se.sales_effort_seq_id = b.sales_effort_seq_id
    LEFT JOIN (
        SELECT
            c.acct_no,
            c.contr_date,
            c.contr_site_orig AS cso,
            c.down_pay,
            c.survey_no,
            c.full_dwn_date,
            c.contr_orig,
            c.sales_volume,
            m.status,
            m.detail,
            m.status_date,
            m.detail_date,
            m.type_code,
            m.type_date,
            c.contract_type
        FROM MRCONTP c
        LEFT JOIN MRMASTERP m
            ON c.acct_no = m.acct_no
        WHERE c.survey_no IS NOT NULL
          AND EXTRACT(YEAR FROM c.contr_date) >= 2025
    ) mr
        ON mr.survey_no = b.sales_effort_seq_id
),
payouts AS (
    SELECT resort,
    invite_number,
    tour_date,
    location_number, 
    tours as tours_orig,
    CASE WHEN tour_payout>0 then 1 ELSE 0 END as tours,
    tour_payout as tour_payout_org,
    total,
    insdate,
    rank() OVER (Partition by invite_number ORDER BY tour_payout desc) as distrank
    FROM paramount_payouts
 
)

    SELECT
        p.*,
        ad.*,
        ROW_NUMBER() OVER (
            PARTITION BY COALESCE(p.invite_number, ad.invite_number)
            ORDER BY ad.tour_status_rank ASC, p.total DESC, contract_rank asc
        ) AS rankpay
    FROM payouts p
    FULL JOIN acct_detail ad
        ON p.invite_number = ad.invite_number
WHERE distrank=1 OR distrank is null



